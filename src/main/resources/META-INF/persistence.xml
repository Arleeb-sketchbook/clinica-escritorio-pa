<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- El nombre "clinica" es el que usa Conexion.java -->
    <persistence-unit name="clinica" transaction-type="RESOURCE_LOCAL">

        <class>logica.Usuario</class>
        <class>logica.Medico</class>
        <class>logica.Paciente</class>
        <class>logica.Terapia</class>
        <class>logica.Estudio</class>
        <class>logica.OrdenMedica</class>
        <class>logica.Seguido</class>
        <class>logica.LineaOrden</class>
        <class>logica.Prestacion</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/clinicadb" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="lapass" />

            <!-- update: Hibernate crea o actualiza las tablas solo, a partir de las entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- Poner en true para ver por consola el SQL que genera Hibernate -->
            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>